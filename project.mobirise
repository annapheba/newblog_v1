    "beingthespark.html": {
      "settings": {
        "title": "Being the spark | June 2016",
        "order": "2",
        "meta_descr": "Experience as a teaching volunteer at Make a Difference organization.",
        "socialSharingUrl": "",
        "meta_image": "@PROJECT_PATH@/assets/images/lolmdlol-2.jpg-659x540.jpg"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
